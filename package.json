{
  "name": "guardias-residentes-backend",
  "version": "1.0.0",
  "description": "Backend (API + BD + Auth) de la app de gestión de guardias de médicos residentes — Hospital Universitario de Dénia",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "gen:sql": "node src/db/gen-supabase-sql.js",
    "test": "node tests/reglas.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pg-connection-string": "^2.13.0",
    "zod": "^3.23.8"
  }
}
