# Copia este archivo a .env y ajusta los valores.

# Servidor
PORT=4000
NODE_ENV=development
# Origen permitido para CORS (frontend). Coma-separado o * para todos.
CORS_ORIGIN=*

# PostgreSQL — usa DATABASE_URL o los campos sueltos.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/guardias_denia
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=guardias_denia

# --- Despliegue (Supabase / Vercel) ---------------------------------------
# SSL: por defecto se activa solo si el host NO es local. Fuerza con PGSSL.
# PGSSL=true
# Tamaño del pool. En Vercel (serverless) usa 1 + el pooler de TRANSACCIONES
# de Supabase (puerto 6543). Para migraciones/seed desde tu PC, usa el pooler
# de SESIÓN (puerto 5432) y deja PG_POOL_MAX sin definir.
# PG_POOL_MAX=1
#
# Ejemplos de DATABASE_URL en Supabase:
#   Migrar/seed (sesión, 5432): postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   API en Vercel (trans, 6543): postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
# Token temporal del flujo de primer acceso (corto)
JWT_TEMP_EXPIRES_IN=15m

# Contraseña por defecto que el seed asigna a los 9 usuarios del prototipo
# (para que el frontend funcione al instante; ver README).
SEED_PASSWORD=Denia2026!

# Token compartido para el enlace público de SOLO LECTURA (GET /publico/guardias),
# que usa la app de turnos de Anestesia para mostrar el residente de guardia de cada
# día. Pon el MISMO valor (largo y aleatorio) aquí y en la app de anestesia. Si se
# deja vacío, el enlace público queda desactivado (devuelve 401).
FEED_TOKEN=
